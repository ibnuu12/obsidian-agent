# Obsidian Local REST API
OBSIDIAN_API_KEY=

# Optional: override the default TLS certificate path
OBSIDIAN_CA_CERT=

# Optional: override the vault path from settings.toml
OBSIDIAN_VAULT_PATH=C:/Path/To/Your/Obsidian/Vault

# LLM configuration
LLM_PROVIDER=none
LLM_API_KEY=
LLM_MODEL=

# Optional application configuration
AGENT_ENV=development
AGENT_LOG_LEVEL=INFO

# Optional: integration test paths
OBSIDIAN_TEST_VAULT_ROOT=
OBSIDIAN_TEST_MOC_PATH=
